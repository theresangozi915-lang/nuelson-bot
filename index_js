const { Client, LocalAuth } = require('whatsapp-web.js');
const qrcode = require('qrcode');
const express = require('express');

const app = express();
let qrCodeData = '';

const client = new Client({
  authStrategy: new LocalAuth(),
  puppeteer: {
    args: ['--no-sandbox', '--disable-setuid-sandbox']
  }
});

client.on('qr', async (qr) => {
  qrCodeData = await qrcode.toDataURL(qr);
  console.log('QR Ready! Open your Render link to scan');
});

client.on('ready', () => {
  console.log('Nuelson Studio Bot is READY! 🎨');
});

client.on('message', async (msg) => {
  if (msg.from.includes('@g.us')) return; // ignore groups
  const text = msg.body.toLowerCase();
  
  let reply = `Welcome to Nuelson Studio 🎨\n\nServices:\n1. Logo Design\n2. Flyers\n3. Video Editing\n4. Branding\n5. Social Media Designs\n\nReply with number (e.g 1) to know price.\n\nHow can I help you?`;

  if (text.includes('1') || text.includes('logo')) reply = "Logo Design: From ₦5,000 for 3 concepts. Professional & modern. Want to see samples?";
  if (text.includes('2') || text.includes('flyer')) reply = "Flyers: ₦3,000 per design. Fast delivery in 2hrs. Send details!";
  if (text.includes('3') || text.includes('video')) reply = "Video Editing: From ₦10,000. Reels, Ads, YouTube. Send your clips!";
  if (text.includes('hi') || text.includes('hello')) reply = `Hello! Welcome to Nuelson Studio 🎨\nHow can I help your brand today?`;

  // Don't auto reply to yourself
  if (!msg.fromMe) {
    await client.sendMessage(msg.from, reply);
  }
});

client.initialize();

// Web server to show QR
app.get('/', async (req, res) => {
  if (client.info) {
    res.send('<h1>Nuelson Studio Bot is LIVE ✅</h1><p>Your WhatsApp bot is connected and replying!</p>');
  } else if (qrCodeData) {
    res.send(`<h1>Scan this QR with WhatsApp</h1><p>WhatsApp > Linked Devices > Link a device</p><img src="${qrCodeData}" style="width:300px"/><br/><p>Refresh page after 30 sec</p><script>setTimeout(()=>location.reload(),10000)</script>`);
  } else {
    res.send('<h1>Starting bot... Please refresh after 20 seconds</h1><script>setTimeout(()=>location.reload(),20000)</script>');
  }
});

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log('Server on ' + PORT));
